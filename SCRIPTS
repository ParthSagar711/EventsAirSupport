/* Event Website - Agenda - Make links clickable on the Website agenda. */
 
 
<script>
const overviewLinkTags = /&lt;\/?a&gt;/gi;
 
function cleanOverview() {
document.querySelectorAll('.agenda-widget__item-overview').forEach(function (el) {
el.innerHTML = el.innerHTML.replace(overviewLinkTags, '');
});
}
 
setInterval(cleanOverview, 500);
 
const linkRegex = /&lt;a&gt;(https?:\/\/.*?)&lt;\/a&gt;/gi;
 
function convertTextLinks() {
document.querySelectorAll('.section-body.is-bold').forEach(function (el) {
if (linkRegex.test(el.innerHTML)) {
el.innerHTML = el.innerHTML.replace(
linkRegex,
'<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'
);
}
});
}
 
setInterval(convertTextLinks, 500);
</script>



/* Event Website - Speaker - Update biography text label and increase the default width. */

/* CSS for Biography whitespace to be removed */
<style>
#speaker-biography {
white-space: pre-line !important;
max-height: none !important;
height: auto !important;
overflow: visible !important;
}
</style>

<script>
    setInterval(function () {
        document.querySelectorAll('body *').forEach(function (element) {
            if (
                element.children.length === 0 &&
                element.textContent.includes('Biography')
            ) {
                element.textContent = element.textContent.replace(
                    /Biography/g,
                    'Details'
                );
            }
        });
    }, 300);

    setInterval(function () {
        var el = document.getElementById('speaker-biography');

        if (el) {
            el.classList.remove('read-more-text__content--collapsed');
        }
    }, 300);
</script>
